import { Palette, Button, VerticalBox, HorizontalBox, ScrollView, AboutSlint } from "std-widgets.slint";

export component PageAbout inherits Rectangle {
    callback open-url(string);
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 22px;
            alignment: start;
            Text { text: "ASUS Control Center"; font-size: 26px; font-weight: 700; color: Palette.foreground; }
            Text { text: "Ubuntu edition 1.4.0  ·  asusctl 6.5.0"; font-size: 12px; color: #efb66a; }
            Text {
                text: "Performance, fan, keyboard and battery controls for ASUS laptops.\nA focused desktop interface with quick profiles in the GNOME panel.";
                font-size: 14px; wrap: word-wrap; color: Palette.foreground;
            }
            Rectangle {
                background: #ffffff09; border-color: #ffffff22; border-width: 1px; border-radius: 12px;
                VerticalLayout {
                    padding: 20px; spacing: 10px;
                    Text { text: "UBUNTU EDITION & PANEL"; font-size: 10px; color: #efb66a; font-weight: 600; }
                    Text { text: "Halis Türk"; font-size: 23px; font-weight: 700; color: Palette.foreground; }
                    Text { text: "hlstrk  ·  Interface, Ubuntu packaging and GNOME integration"; font-size: 12px; color: Palette.foreground; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 10px; alignment: start;
                        Button { text: "GitHub profile"; clicked => { root.open-url("https://github.com/hlstrk"); } }
                        Button { text: "Project & downloads"; clicked => { root.open-url("https://github.com/hlstrk/asus-control-center-ubuntu"); } }
                    }
                }
            }
            Text { text: "Built on open source"; font-size: 16px; font-weight: 700; color: Palette.foreground; }
            Text {
                text: "Hardware control is provided by asusctl, maintained by Luke Jones, Denis Benato and the ASUS Linux / OpenGamingCollective contributors. Their source and copyright notices are preserved.\n\nThis is an independent community edition, not an official ASUS application. The project uses MPL-2.0; third-party files retain their own licenses. The desktop UI is powered by Slint.";
                wrap: word-wrap; color: Palette.foreground; font-size: 12px;
            }
            HorizontalLayout {
                spacing: 10px; alignment: start;
                Button { text: "Upstream project"; clicked => { root.open-url("https://github.com/OpenGamingCollective/asusctl"); } }
                Button { text: "Slint"; clicked => { root.open-url("https://slint.dev"); } }
            }
        }
    }
}
