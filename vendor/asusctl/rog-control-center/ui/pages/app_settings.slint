import { AppMode } from "../globals.slint";
import { Palette, Button, Switch, ScrollView } from "std-widgets.slint";
import { SystemToggle } from "../widgets/common.slint";

export enum GlobalShortcutStatus {
    disabled,
    starting,
    unassigned,
    listening,
    unavailable,
}

export global AppSettingsPageData {
    in-out property <bool> run_in_background;
    callback set_run_in_background(bool);
    in-out property <bool> startup_in_background;
    callback set_startup_in_background(bool);
    in-out property <bool> enable_tray_icon;
    callback set_enable_tray_icon(bool);
    in-out property <bool> enable_dgpu_notifications;
    callback set_enable_dgpu_notifications(bool);
    in-out property <bool> enable_autostart;
    callback set_enable_autostart(bool);
    in-out property <bool> autostart_in_background;
    callback set_autostart_in_background(bool);
    // Whether the global shortcut controls are shown (false on ROG Ally).
    in-out property <bool> show_global_shortcut_controls;
    in-out property <bool> enable_global_shortcut;
    callback set_enable_global_shortcut(bool);
    in-out property <GlobalShortcutStatus> global_shortcut_status;
    // Portal capability (interface version >= 2): the desktop's shortcut
    // configuration UI can be opened from here.
    in-out property <bool> global_shortcut_configurable;
    // Routes by status: Bind on first use, Configure when active.
    callback manage_global_shortcut();
}

export global TelemetryPageData {
    in-out property <bool> choice-known: false;
    in-out property <bool> enabled: false;
    in-out property <string> status: "Statistics are off";
    callback set-consent(bool);
}

component SettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 66px; background: #1d242b; border-width: 1px; border-color: #ffffff18; border-radius: 6px;
    HorizontalLayout {
        padding: 14px; spacing: 20px;
        VerticalLayout {
            spacing: 5px;
            Text { text: root.title; color: #f4f1e9; font-size: 13px; font-weight: 600; }
            Text { text: root.description; color: #aab2bb; font-size: 10px; overflow: elide; }
        }
        Switch { enabled: root.enabled; checked <=> root.checked; accessible-label: root.title; toggled => { root.toggled(self.checked); } }
    }
}

export component PageAppSettings inherits Rectangle {
    ScrollView {
        VerticalLayout {
            padding: 20px; spacing: 10px; alignment: start;
            Rectangle { height: 60px; background: transparent;
                VerticalLayout { spacing: 6px;
                    Text { text: "Application preferences"; font-size: 25px; font-weight: 700; color: #f4f1e9; }
                    Text { text: "Startup, the ASUS key, notifications and optional diagnostics."; font-size: 11px; color: #aab2bb; }
                }
            }
            Text { text: "STARTUP & WINDOW"; font-size: 11px; font-weight: 700; color: #efb66a; }
            SettingsRow { title: "Keep running after closing"; description: "Closing the window keeps background controls available; Quit App still exits."; checked <=> AppSettingsPageData.run_in_background; toggled => { AppSettingsPageData.set_run_in_background(self.checked); } }
            SettingsRow { title: "Start with window hidden"; description: "When launching normally, keep the desktop window in the background."; checked <=> AppSettingsPageData.startup_in_background; toggled => { AppSettingsPageData.set_startup_in_background(self.checked); } }
            SettingsRow { title: "Start on login"; description: "Launch the control center when you sign in to your desktop."; checked <=> AppSettingsPageData.enable_autostart; toggled => { AppSettingsPageData.set_enable_autostart(self.checked); } }
            if AppSettingsPageData.enable_autostart: SettingsRow { title: "Hide window on login"; description: "Run quietly when launched by your login session."; checked <=> AppSettingsPageData.autostart_in_background; toggled => { AppSettingsPageData.set_autostart_in_background(self.checked); } }
            if AppSettingsPageData.show_global_shortcut_controls: Text { text: "ASUS / ROG KEY"; font-size: 11px; font-weight: 700; color: #efb66a; }
            if AppSettingsPageData.show_global_shortcut_controls: SettingsRow {
                title: "Open / hide with the ASUS key"; description: "On GNOME the key also starts the app after Quit App.";
                checked <=> AppSettingsPageData.enable_global_shortcut;
                enabled: AppSettingsPageData.global_shortcut_status != GlobalShortcutStatus.starting;
                toggled => { AppSettingsPageData.set_enable_global_shortcut(self.checked); }
            }
            if AppSettingsPageData.show_global_shortcut_controls && AppSettingsPageData.enable_global_shortcut: HorizontalLayout {
                spacing: 10px;
                Text { vertical-alignment: center; color: #aab2bb; font-size: 11px;
                    text: AppSettingsPageData.global_shortcut_status == GlobalShortcutStatus.listening ? "ASUS key ready" : AppSettingsPageData.global_shortcut_status == GlobalShortcutStatus.starting ? "Setting up the key…" : AppSettingsPageData.global_shortcut_status == GlobalShortcutStatus.unavailable ? "Key setup unavailable; check for a conflicting desktop shortcut." : "Assign a shortcut to finish setup.";
                }
                Rectangle {}
                if AppSettingsPageData.global_shortcut_status == GlobalShortcutStatus.unavailable || AppSettingsPageData.global_shortcut_status == GlobalShortcutStatus.unassigned || AppSettingsPageData.global_shortcut_configurable: Button {
                    text: AppSettingsPageData.global_shortcut_status == GlobalShortcutStatus.unavailable ? "Retry setup" : "Configure shortcut";
                    clicked => { AppSettingsPageData.manage_global_shortcut(); }
                }
            }
            Text { text: "NOTIFICATIONS"; font-size: 11px; font-weight: 700; color: #efb66a; }
            SettingsRow { title: "GPU status notifications"; description: "Notify when the discrete GPU power state changes."; checked <=> AppSettingsPageData.enable_dgpu_notifications; toggled => { AppSettingsPageData.set_enable_dgpu_notifications(self.checked); } }
            if AppMode.advanced: SettingsRow { title: "Legacy tray icon"; description: "Optional fallback for other desktops; the GNOME panel works independently."; checked <=> AppSettingsPageData.enable_tray_icon; toggled => { AppSettingsPageData.set_enable_tray_icon(self.checked); } }
            Text { text: "OPTIONAL STATISTICS"; font-size: 11px; font-weight: 700; color: #efb66a; }
            SettingsRow { title: "Share anonymous statistics"; description: "Help improve the app with limited compatibility statistics and safe error codes."; checked <=> TelemetryPageData.enabled; toggled => { TelemetryPageData.set-consent(self.checked); } }
            Rectangle { height: 110px; background: #14191e; border-radius: 6px;
                VerticalLayout { padding: 14px; spacing: 7px;
                    Text { text: "App / OS versions, desktop session, CPU/GPU vendors and fixed error codes. A random installation ID controls report limits. No account details, serial numbers, file paths, audio or transcripts."; wrap: word-wrap; color: #aab2bb; font-size: 11px; }
                    Text { text: "At most 3 compatibility reports and 5 safe error reports per day. No personal files or raw logs."; color: #aab2bb; font-size: 10px; }
                    Text { text: TelemetryPageData.status; color: #efb66a; font-size: 11px; }
                }
            }
        }
    }
}
