import { Palette, Button, VerticalBox } from "std-widgets.slint";
import { AppSize, AppMode } from "globals.slint";
import { PageSystem, SystemPageData, AttrMinMax } from "pages/system.slint";
import { SideBar } from "widgets/sidebar.slint";
import { PageAbout } from "pages/about.slint";
import { PageFans } from "pages/fans.slint";
import { PageAnime, AnimePageData } from "pages/anime.slint";
import { PageSlash, SlashPageData } from "pages/slash.slint";
import { RogItem } from "widgets/common.slint";
import { PageAura } from "pages/aura.slint";
import { PageGPU, GPUPageData } from "pages/gpu.slint";
import { PageBattery } from "pages/battery.slint";
import { Node } from "widgets/graph.slint";
export { Node }
import { FanPageData, FanType, Profile } from "types/fan_types.slint";
export { FanPageData, FanType, Profile }
import { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect } from "types/aura_types.slint";
export { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect }
import { PageAppSettings, AppSettingsPageData, TelemetryPageData, GlobalShortcutStatus } from "pages/app_settings.slint";

export { AppMode, AppSize, AttrMinMax, SystemPageData, AnimePageData, SlashPageData, AppSettingsPageData, TelemetryPageData, GlobalShortcutStatus, GPUPageData }

component ModeChoice inherits Rectangle {
    in property <bool> active;
    in property <string> text;
    callback clicked();
    width: 86px; height: 32px;
    border-radius: 7px;
    background: root.active ? #efb66a : #ffffff09;
    border-width: 1px;
    border-color: focus.has-focus ? #ffffff : transparent;
    accessible-role: button;
    accessible-label: root.active ? root.text + " selected" : root.text;
    forward-focus: focus;
    animate background { duration: 120ms; }
    Text { text: root.text; color: root.active ? #251a0d : #ded8ce; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    TouchArea { clicked => { focus.focus(); root.clicked(); } }
}

export component MainWindow inherits Window {
    title: "ASUS Control Center";
    always-on-top: false;
    no-frame: true;
    callback drag-window();
    callback resize-window();
    callback close-window();
    callback open-url(string);
    default-font-family: "Ubuntu";
    default-font-size: 14px;
    default-font-weight: 400;
    icon: @image-url("../data/rog-control-center.png");
    in property <[bool]> sidebar_items_avilable: [
        true,
        true,
        true,
        true,
        true,
        true, // GPU Configuration
        true, // Battery Info
        true, // App Settings
        true, // About
    ];
    private property <bool> show_notif;
    // TODO: change if TUF on the logo in the menu on the main page
    in property <bool> is_tuf: false;
    private property <bool> fade_cover;
    private property <bool> toast: false;
    private property <string> toast_text: "I show when something is waiting";
    callback show_toast(string);
    show_toast(text) => {
        toast = text != "";
        toast_text = text;
    }
    callback clear_toast_if_matches(string);
    clear_toast_if_matches(text) => {
        if (toast && toast_text == text) {
            toast = false;
            toast_text = "";
        }
    }
    callback exit-app();
    callback show_notification(bool);
    show_notification(yes) => {
        show_notif = yes;
        fade_cover = yes;
    }
    callback external_colour_change();
    external_colour_change() => {
        aura.external_colour_change();
        aura.external_colour_change();
    }
    min-height: AppSize.height;
    min-width: AppSize.width;
    background: transparent;

    frame := Rectangle {
      x: 3px; y: 3px;
      width: root.width - 6px;
      height: root.height - 6px;
      border-radius: 18px;
      border-width: 1px;
      border-color: #ffffff22;
      background: #1b1f25f5;
      clip: true;

      Rectangle {
        x: 0px; y: 0px;
        width: frame.width;
        height: 52px;
        background: transparent;
        TouchArea {
            width: frame.width - 360px; height: 52px;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.drag-window(); }
            }
        }
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 22px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            Text { text: "ASUS Control Center"; font-size: 12px; font-weight: 700; color: #f4f1e9; vertical-alignment: center; }
            Rectangle {}
            ModeChoice { text: "Basic"; active: !AppMode.advanced; clicked => { AppMode.advanced = false; side-bar.current-item = 0; } }
            ModeChoice { text: "Advanced"; active: AppMode.advanced; clicked => { AppMode.advanced = true; } }
            Rectangle { width: 12px; }
            Button { text: "−"; accessible-label: "Minimize window"; width: 32px; clicked => { root.minimized = true; } }
            Button { text: "□"; accessible-label: "Maximize or restore window"; width: 32px; clicked => { root.maximized = !root.maximized; } }
            Button { text: "×"; accessible-label: "Close window"; width: 32px; clicked => { root.close-window(); } }
        }
      }

    HorizontalLayout {
        y: 52px;
        width: frame.width;
        height: frame.height - 52px;
        padding: 0px;
        VerticalLayout {
            padding: 0px;
            side-bar := SideBar {
                model: [
                    @tr("Menu1" => "System Control"),
                    AuraPageData.lighting-title,
                    @tr("Menu3" => "AniMe Matrix"),
                    @tr("Menu4" => "Slash Lighting"),
                    @tr("Menu5" => "Fan Curves"),
                    @tr("Menu6" => "GPU Configuration"),
                    @tr("Menu9" => "Battery Info"),
                    @tr("Menu7" => "App Settings"),
                    @tr("Menu8" => "About"),
                ];
                available: [
                    root.sidebar_items_avilable[0], root.sidebar_items_avilable[1],
                    root.sidebar_items_avilable[2] && AppMode.advanced,
                    root.sidebar_items_avilable[3] && AppMode.advanced,
                    root.sidebar_items_avilable[4] && AppMode.advanced,
                    root.sidebar_items_avilable[5] && AppMode.advanced,
                    root.sidebar_items_avilable[6], root.sidebar_items_avilable[7], root.sidebar_items_avilable[8],
                ];
                is_tuf: root.is_tuf;
                navigated => { page-content.entering = true; page-transition.running = true; }
            }

            Button {
                height: 40px;
                width: side-bar.width;
                text: @tr("Quit App");
                clicked() => {
                    root.exit-app();
                }
            }
        }

        page-content := Rectangle {
            property <bool> entering: false;
            opacity: AppMode.animations-enabled && self.entering ? 0.15 : 1;
            animate opacity { duration: self.entering ? 0ms : 180ms; }
            background: transparent;
            if(side-bar.current-item == 0): page := PageSystem {
                width: frame.width - side-bar.width;
                height: frame.height - 52px;
            }

            /*if(side-bar.current-item == 1):*/ aura := PageAura {
                width: frame.width - side-bar.width;
                height: frame.height - 52px;
                visible: side-bar.current-item == 1;
            }

            if(side-bar.current-item == 2): PageAnime {
                width: frame.width - side-bar.width;
                height: frame.height - 52px;
                visible: side-bar.current-item == 2;
            }

            if(side-bar.current-item == 3): PageSlash {
                width: frame.width - side-bar.width;
                height: frame.height - 52px;
                visible: side-bar.current-item == 3;
            }

            if(side-bar.current-item == 4): fans := PageFans {
                width: frame.width - side-bar.width;
                height: frame.height - 52px;
                visible: side-bar.current-item == 4;
            }

            if(side-bar.current-item == 5): PageGPU {
                width: frame.width - side-bar.width;
                height: frame.height - 52px;
                visible: side-bar.current-item == 5;
            }

            if(side-bar.current-item == 6): PageBattery {
                width: frame.width - side-bar.width;
                height: frame.height - 52px;
                visible: side-bar.current-item == 6;
            }

            if(side-bar.current-item == 7): PageAppSettings {
                width: frame.width - side-bar.width;
                height: frame.height - 52px;
                visible: side-bar.current-item == 7;
            }

            if(side-bar.current-item == 8): PageAbout {
                open-url(url) => { root.open-url(url); }
                width: frame.width - side-bar.width;
                height: frame.height - 52px;
                visible: side-bar.current-item == 8;
            }

            if toast: Rectangle {
                x: 0px;
                y: root.height - self.height;
                width: frame.width - side-bar.width;
                height: 40px;
                opacity: 1.0;
                background: Palette.selection-background;
                clip: true;
                TouchArea {
                    height: 100%;
                    width: 100%;
                    clicked => {
                        toast = false;
                    }
                }

                Rectangle {
                    height: 100%;
                    width: 100%;
                    background: Palette.control-background;
                    Text {
                        color: Palette.control-foreground;
                        text: root.toast_text;
                    }
                }
            }
        }
    }

    page-transition := Timer { interval: 30ms; running: false; triggered => { page-content.entering = false; self.running = false; } }

    if fade_cover: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: frame.height - 52px;
        background: Colors.rgba(25,33,23,20);
        opacity: 0.7;
        TouchArea {
            height: 100%;
            width: 100%;
            clicked => {
                // toolbar-dropdown.close();
                if (show_notif) {
                    show_notif = false;
                }
                fade_cover = false;
            }
        }
    }


    // // TODO: or use Dialogue
    if show_notif: Rectangle {
        x: root.width / 8;
        y: root.height / 8;
        height: (root.height / 8) * 6;
        width: (root.width / 8) * 6;
        TouchArea {
            height: 100%;
            width: 100%;
            clicked => {
                show_notif = false;
                exit-app();
            }
        }

        // TODO: add properties to display
        Rectangle {
            height: 100%;
            width: 100%;
            background: Palette.background;
            Text {
                text: "Click here to exit";
            }
        }
    }

    if SomeError.error_message != "": Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: frame.height - 52px;
        background: Palette.background;
        border-color: Palette.border;
        border-width: 3px;
        border-radius: 10px;

        VerticalBox {
            RogItem {
                min-height: 50px;
                max-height: 100px;
                Text {
                    text <=> SomeError.error_message;
                    font-size: 18px;
                }
            }

            Text {
                text <=> SomeError.error_help;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
    }
    if !TelemetryPageData.choice-known: Rectangle {
        width: frame.width; height: frame.height; background: #101419e8;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (frame.width - self.width) / 2; y: (frame.height - self.height) / 2;
            width: 570px; height: 285px; background: #20272f; border-radius: 12px; border-width: 1px; border-color: #ffffff25;
            VerticalLayout { padding: 24px; spacing: 14px;
                Text { text: "Help make ASUS Control Center better?"; font-size: 22px; font-weight: 700; color: #f4f1e9; }
                Text { text: "Would you like to help improve the app? Share a few anonymous compatibility statistics and error codes so we can spot problems and make future versions better."; wrap: word-wrap; font-size: 12px; color: #c6cbd1; }
                Text { text: "No names, serial numbers, files or recordings are sent. Sharing is optional, stays off until you agree, and can be turned off anytime in App Settings."; wrap: word-wrap; font-size: 12px; color: #c6cbd1; }
                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "No thanks"; clicked => { TelemetryPageData.set-consent(false); } }
                    Button { text: "Yes, happy to help"; clicked => { TelemetryPageData.set-consent(true); } }
                }
            }
        }
    }
      Text { x: frame.width - 20px; y: frame.height - 20px; text: "⋰"; color: #9da4ac; }
      TouchArea {
        x: frame.width - 22px; y: frame.height - 22px; width: 22px; height: 22px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.resize-window(); }
        }
      }
    }
}

export global SomeError {
    in property <string> error_message: "";
    in property <string> error_help: "";
}
